{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/v1/albums/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],

      "DownstreamPathTemplate": "/api/v1/albums/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7086 // Puerto del API
        }
      ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },

      "CacheOptions": {
        "TtlSeconds": 30
      },

      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "1m",
        "Limit": 100,
        "ClientIdHeader": "ClientId"
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/v2/albums/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],

      "DownstreamPathTemplate": "/api/v2/albums/{everything}",
